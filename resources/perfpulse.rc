#include <winres.h>
#include "../src/app/resource_ids.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDI_PERFPULSE ICON "perfpulse.ico"

IDR_REPORT_TEMPLATE RCDATA "report/report_template.html"
IDR_INDEX_TEMPLATE RCDATA "report/index_template.html"

1 RT_MANIFEST "perfpulse.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PerfPulse"
            VALUE "FileDescription", "PerfPulse - game performance recorder"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "PerfPulse"
            VALUE "OriginalFilename", "PerfPulse.exe"
            VALUE "ProductName", "PerfPulse"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
